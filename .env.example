# Conexão do Neon Postgres, configurada na Vercel e usada apenas no servidor.
DATABASE_URL=

# Opcionais para a execução local de Estoq.
ESTOQ_DATA_DIR=
ESTOQ_OPEN_BROWSER=0

# Obrigatórios no servidor. Configure hashes scrypt privados para os perfis.
# Não há senha padrão. Nunca use NEXT_PUBLIC_ para esses valores.
LAYLAH_PASSWORD_HASH=
CAIO_PASSWORD_HASH=
